
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TEAM_MEMBER
}

enum TaskStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  REVISION_REQUIRED
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum SubmissionStatus {
  SUBMITTED
}

model User {
  id            String           @id @default(cuid())
  name          String
  email         String           @unique
  password      String
  employeeId    String?          @unique
  department    String?
  designation   String?          @default("Team Member")
  phone         String?
  avatarUrl     String?
  role          UserRole         @default(TEAM_MEMBER)

  tasks         Task[]           @relation("AssignedTasks")
  updates       TaskUpdate[]
  notifications Notification[]
  submissions   TaskSubmission[] @relation("MemberSubmissions")

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  tasks       Task[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Task {
  id           String           @id @default(cuid())
  title        String
  description  String?
  status       TaskStatus       @default(ASSIGNED)
  priority     TaskPriority     @default(MEDIUM)
  dueDate      DateTime?
  progress     Int              @default(0)

  assignedToId String
  assignedTo   User             @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: Cascade)

  projectId    String?
  project      Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)

  updates      TaskUpdate[]
  submissions  TaskSubmission[]

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([assignedToId, status])
}

model TaskUpdate {
  id        String     @id @default(cuid())

  taskId    String
  task      Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  progress  Int
  status    TaskStatus
  workNotes String
  createdAt DateTime   @default(now())
}

model Notification {
  id        String   @id @default(cuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model TaskSubmission {
  id          String           @id @default(cuid())

  taskId      String
  task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)

  memberId    String
  member      User             @relation("MemberSubmissions", fields: [memberId], references: [id], onDelete: Cascade)

  description String?
  fileName    String
  filePath    String

  status      SubmissionStatus @default(SUBMITTED)
  submittedAt DateTime         @default(now())

  @@index([taskId])
  @@index([memberId])
}
